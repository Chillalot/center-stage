#: center_stage/gui.py:47 center_stage/gui.py:209 center_stage/gui.py:450
msgid "Camera is disconnected"
msgstr "Camera đã ngắt kết nối"

#: center_stage/gui.py:48
msgid "Connecting camera…"
msgstr "Đang kết nối camera…"

#: center_stage/gui.py:49
msgid "Camera is ready"
msgstr "Camera đã sẵn sàng"

