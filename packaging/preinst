#!/bin/sh
set -e

case "${1:-install}" in
    install|upgrade) ;;
    *) exit 0 ;;
esac

if ! modinfo v4l2loopback >/dev/null 2>&1; then
    echo "Center Stage: install v4l2loopback before installing this package." >&2
    exit 1
fi

if [ -e /dev/video10 ]; then
    device_label=$(cat /sys/class/video4linux/video10/name 2>/dev/null || true)
    if [ "$device_label" != "Center Stage" ]; then
        echo "Center Stage: refusing to replace the device already using /dev/video10." >&2
        exit 1
    fi
fi

if [ "${1:-}" = "upgrade" ] && command -v loginctl >/dev/null 2>&1; then
    loginctl list-users --no-legend 2>/dev/null | while read -r uid user _; do
        [ -n "$uid" ] || continue
        runtime="/run/user/$uid"
        [ -S "$runtime/bus" ] || continue
        runuser -u "$user" -- env \
            XDG_RUNTIME_DIR="$runtime" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
            systemctl --user stop center-stage-engine.service >/dev/null 2>&1 || true
    done
fi

exit 0
